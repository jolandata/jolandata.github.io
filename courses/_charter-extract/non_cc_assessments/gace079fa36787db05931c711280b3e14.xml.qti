    <item ident="ge764b6d22894ab3f73c4bdb867607828" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>8303,1120,6498,7911</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;&lt;strong&gt;Which of the following describes a promise of the metaverse related to user security and transactions?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;A. AI-generated avatars&lt;br&gt;B. Exchange traded products (ETPs) as native cryptocurrency&lt;br&gt;C. Enhanced user interfaces for virtual reality&lt;br&gt;D. AI-powered virtual environments for education&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8303">
              <material>
                <mattext texttype="text/plain">B. Exchange traded products (ETPs) as native cryptocurrency</mattext>
              </material>
            </response_label>
            <response_label ident="1120">
              <material>
                <mattext texttype="text/plain">A. AI-generated avatars</mattext>
              </material>
            </response_label>
            <response_label ident="6498">
              <material>
                <mattext texttype="text/plain">C. Enhanced user interfaces for virtual reality</mattext>
              </material>
            </response_label>
            <response_label ident="7911">
              <material>
                <mattext texttype="text/plain">D. AI-powered virtual environments for education</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">8303</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="8303_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">1120</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="1120_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">6498</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="6498_fb"/>
        </respcondition>
        <respcondition continue="Yes">
          <conditionvar>
            <varequal respident="response1">7911</varequal>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="7911_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8303</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="8303_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;strong&gt;Correct Answer:&lt;/strong&gt; B. Exchange traded products (ETPs) as native cryptocurrency&lt;br&gt;&lt;strong&gt;Explanation:&lt;/strong&gt; ETPs as native cryptocurrency in the metaverse ensure secure, transparent, and efficient digital transactions. Option A is about AI's role in social interactions. Option C pertains to HCI design. Option D relates to the application of AI in education.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="1120_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;h4&gt;Explanation of Incorrect Answer&lt;/h4&gt;
&lt;h4&gt;Question 1:&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;A. AI-generated avatars&lt;/strong&gt;: This is an AI application for social interactions.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Try again?&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="6498_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;h4&gt;Explanation of Incorrect Answer&lt;/h4&gt;
&lt;h4&gt;Question 1:&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;C. Enhanced user interfaces for virtual reality&lt;/strong&gt;: This is related to HCI.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Try again?&lt;/p&gt;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
      <itemfeedback ident="7911_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&lt;h4&gt;Explanation of Incorrect Answer&lt;/h4&gt;
&lt;h4&gt;Question 1:&lt;/h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;D. AI-powered virtual environments for education&lt;/strong&gt;: This is an application of AI in education.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;Try again?&lt;/p&gt;</mattext>
